{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bento-api-poc",
  "main": "src/formalWorker.js",
  "compatibility_date": "2026-09-07",
  "vars": {
    "VENDOR_CODE_LOGIN_ENABLED": "true",
    "LINE_CHANNEL_ID": "2011372097"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bento-formal",
      "database_id": "e75bc185-afb5-4a5d-abc9-81bd79525cff",
      "migrations_dir": "migrations-formal"
    }
  ],
  "triggers": {
    "crons": [
      "0 16 * * *",
      "0 8 * * *",
      "0 2,10 * * *",
      "50 1,9 * * *",
      "30 0 15 6-12 *"
    ]
  }
}
