# Production / LIFF mode is the safe default.
VITE_AUTH_MODE=liff
VITE_LIFF_ID=replace-with-your-liff-id
VITE_API_TRANSPORT=worker
VITE_WORKER_API_URL=https://replace-with-formal-worker.example.workers.dev

# GAS is retired and is not a production transport. Historical GAS settings
# are retained only as commented legacy reference for old regression tests.
# VITE_API_TRANSPORT=gas
# VITE_GAS_API_URL=https://script.google.com/macros/s/retired-deployment-id/exec

# Local development only. Vite DEV is required before mock mode can activate.
# VITE_AUTH_MODE=mock
# VITE_MOCK_USER=user
