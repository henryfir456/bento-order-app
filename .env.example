# Production / LIFF mode is the safe default.
VITE_AUTH_MODE=liff
VITE_LIFF_ID=replace-with-your-liff-id
VITE_API_TRANSPORT=gas
VITE_GAS_API_URL=https://script.google.com/macros/s/replace-with-your-gas-deployment-id/exec
# Set VITE_API_TRANSPORT=worker and provide the formal Worker origin only in an
# explicitly isolated Worker verification environment.
# VITE_WORKER_API_URL=https://replace-with-formal-worker.example.workers.dev

# Local development only. Vite DEV is required before mock mode can activate.
# VITE_AUTH_MODE=mock
# VITE_MOCK_USER=user
